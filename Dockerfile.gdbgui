# ── Stage 1: build the React/Webpack frontend ─────────────────────────────
FROM node:20-slim AS frontend-builder
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit
COPY . .
RUN NODE_ENV=production node --openssl-legacy-provider node_modules/.bin/webpack --mode production --config webpack.config.js

# In-browser C++ engine assets (clang.wasm/lld.wasm/sysroot.tar/headers.tar, ~92 MB): pinned via
# the npm package `browsercc` in gdbgui/static/engine/package.json, but gdbgui/static/engine/assets/
# itself is git-ignored (too big for the repo) and must be rebuilt on every image build — a plain
# `COPY . .` from a fresh clone would silently ship an image with no assets/, 404-ing every wasm
# engine page load. build-assets.mjs only reads node_modules/browsercc/dist + the checked-in
# gdbgui/static/engine/include/**, so this is a private, deterministic install/build, not
# reachable via any web-facing route.
RUN cd gdbgui/static/engine && npm ci --no-audit && npm run build-assets

# ── Stage 2: Python runtime ────────────────────────────────────────────────
FROM python:3.13-slim AS runtime-base

# The only system packages the server still shells out to: /tts_audio decodes the gTTS MP3
# with `mpg123` and re-encodes it with `oggenc` (from vorbis-tools); if either is missing it
# silently falls back to MP3. C++ is compiled and debugged in the browser (wasm engine), so
# there is no compiler, gdb or per-session sandbox tooling in this image.
RUN apt-get update && apt-get install -y --no-install-recommends \
    mpg123 vorbis-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY . .
# Bring in the freshly built JS bundles and wasm engine assets from Stage 1 (both are git-ignored
# and must come from the build, not from whatever a `COPY . .` from the host happened to pick up).
COPY --from=frontend-builder /app/gdbgui/static/js/ ./gdbgui/static/js/
COPY --from=frontend-builder /app/gdbgui/static/engine/assets/ ./gdbgui/static/engine/assets/

RUN pip install -e . --no-deps

# 把「這個 image 是從哪一版原始碼建出來的」烙進去。e2e 啟動前會比對它與
# 工作區的指紋，不同就拒絕開跑——避免對著一個不是你剛建的容器測半天。
RUN python scripts/source_stamp.py > /app/.build-stamp && cat /app/.build-stamp

EXPOSE 5000
CMD ["python", "-m", "gdbgui", "--host=0.0.0.0", "--port=5000"]

# ── Stage 3 (tests only): runtime + g++ ───────────────────────────────────
# tests/test_dp_course_lessons.py compiles each DP lesson's .cpp with g++ and checks the
# printed answer. That is lesson-content checking, not something the server does, so the
# compiler lives only in this target (docker-compose.test.yml builds `target: test`).
FROM runtime-base AS test
RUN apt-get update && apt-get install -y --no-install-recommends g++ \
    && rm -rf /var/lib/apt/lists/*

# ── Final stage = production image (no compiler) ───────────────────────────
# Must stay LAST: a plain `docker build` / `docker compose build` without a target builds
# the last stage. docker-compose.yml also names it explicitly (`target: runtime`).
FROM runtime-base AS runtime
