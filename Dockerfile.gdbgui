# ── Stage 1: build the React/Webpack frontend ─────────────────────────────
FROM node:16-slim AS frontend-builder
WORKDIR /app
COPY package*.json ./
RUN npm install --no-audit --no-fund
COPY . .
RUN npm run build

# ── Stage 2: Python runtime ────────────────────────────────────────────────
FROM python:3.13-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential g++ gdb ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY . .
# Bring in the freshly built JS bundles from Stage 1
COPY --from=frontend-builder /app/gdbgui/static/js/ ./gdbgui/static/js/

RUN pip install -e . --no-deps

EXPOSE 5000
CMD ["python", "-m", "gdbgui", "--host=0.0.0.0", "--port=5000"]
