{"done": true, "code": "#include <iostream>\n#include <vector>\nusing namespace std;\n\nint main() {\n    int n = 6;  //@ @tts [next] 我們從 n 等於 6 開始，接下來要玩一個很有名的數列遊戲 @layout sidebar:50 open:container close:locals\n    vector<int> sequence;  //@ @guide {n} @tts [next] 起始值 {n} 已經就位，先準備一個空的向量 sequence，用來記錄走過的每一個數字 @layout sidebar:55 open:container\n    sequence.push_back(n);  //@ @guide {sequence} @tts [next] 把起始值 {n} 放進數列的第一格 @layout sidebar:55 open:container\n    while (n != 1) {  //@ @guide 目前數列：{sequence} @tts [next] 只要 n 還不等於 1，就繼續往下算 | @2 [next] 這一輪做完了，看看 n 是不是已經變成 1 @layout sidebar:55 open:container\n        if (n % 2 == 0) {  //@ @guide {n} @tts [next] 檢查目前的 n 等於 {n}，它是偶數嗎\n            n = n / 2;  //@ @guide {n} @tts [next] 是偶數，就把 n 除以 2\n        } else {  //@ @tts [next] 不是偶數的話，走另一條路\n            n = 3 * n + 1;  //@ @guide {n} @tts [next] 是奇數，就把 n 乘 3 再加 1\n        }\n        sequence.push_back(n);  //@ @guide {sequence} @tts [next] 把剛算出來的 {n} 接到數列尾端 @layout sidebar:55 open:container\n    }\n    return 0;  //@ @guide {sequence} @tts [continue] n 已經變成 1，數列總共 {sequence}，程式結束\n}", "warnings": [], "repaired": true, "prose_guides_dropped": 0, "comments_restored": 0}