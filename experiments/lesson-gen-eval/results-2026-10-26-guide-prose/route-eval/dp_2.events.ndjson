{"done": true, "code": "// 教案：DP 課 ②——兩層迴圈把一張表填滿\n// 跟第 ① 課比只多一件事：格子從一列變成一張表，所以編號要兩個（列 i、行 w）。\n// 這張表的大小（4 列 7 行）和第 ③ 課的背包表一模一樣，中間的公式故意寫得很笨。\n#include <iostream>\n#include <vector>\n\nint main() {\n    std::vector<std::vector<int>> table(4, std::vector<int>(7, 0));  //@ @tts [next] 先開一張四列七行的表，每一格都先填零 @layout sidebar:55 open:container close:locals\n    for (int i = 1; i <= 3; ++i) {  //@ @guide {table} 外層迴圈：一列一列往下填 @tts [next] 開始一列一列往下填 | @2 [next] 這一列填完了，看還有沒有下一列 @layout sidebar:55 open:container\n        for (int w = 0; w <= 6; ++w) {  //@ @tts [next] 第 {i} 列，從最左邊開始一格一格往右填 | @2 [next] 這一格填完了，看還有沒有下一格\n            int value = i * 10 + w;  //@ @guide 第 {i} 列第 {w} 行 @tts [next] 第 {i} 列第 {w} 行，先算出這一格要放的值\n            table[i][w] = value;  //@ @guide {table[i][w]:lightblue} 寫進這一格 @tts [next] 把 {value} 寫進第 {i} 列第 {w} 行 @layout pop:table\n        }\n    }\n    int corner = table[3][6];  //@ @guide {table[3][6]:orange} 右下角那一格 @tts [next] 兩層迴圈都跑完了，把最右下角那一格的值讀出來 @layout pop:table:orange\n    std::cout << corner << \"\\n\";  //@ @guide {corner} @tts [next] 印出 {corner}，這就是整張表填完之後的結果\n    return 0;  //@ @tts [continue] 程式結束\n}", "warnings": ["沒有呼叫圖的程式，已移除 1 行純敘述的 @guide（敘述請放 @tts）"], "repaired": true, "prose_guides_dropped": 1, "comments_restored": 0}