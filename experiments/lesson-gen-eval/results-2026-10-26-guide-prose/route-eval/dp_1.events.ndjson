{"done": true, "code": "// 教案：DP 課 ②——兩層迴圈把一張表填滿\n// 跟第 ① 課比只多一件事：格子從一列變成一張表，所以編號要兩個（列 i、行 w）。\n// 這張表的大小（4 列 7 行）和第 ③ 課的背包表一模一樣，中間的公式故意寫得很笨。\n#include <iostream>\n#include <vector>\n\nint main() {\n    std::vector<std::vector<int>> table(4, std::vector<int>(7, 0));  //@ @tts [next] 這次要填的不是一列，而是一整張表，四列七行，先全部設成零 @layout sidebar:55 open:container close:locals\n    for (int i = 1; i <= 3; ++i) {  //@ @guide {table} 外層迴圈：一列一列往下填 @tts [next] 開始一列一列往下填 | @2 [next] 這一列填完了，看還有沒有下一列\n        for (int w = 0; w <= 6; ++w) {  //@ @guide 內層迴圈：第 {i} 列，一行一行往右填 @tts [next] 第 {i} 列，從最左邊開始一行一行往右 | @2 [next] 這一行填完了，看還有沒有下一行\n            int value = i * 10 + w;  //@ @guide {i} {w} @tts [next] 第 {i} 列第 {w} 行，先算出要填的值\n            table[i][w] = value;  //@ @guide {table[i][w]:lightblue} @tts [next] 把 {value} 寫進第 {i} 列第 {w} 行 @layout pop:table\n        }\n    }\n    int corner = table[3][6];  //@ @guide {table[3][6]:orange} @tts [next] 整張表填完了，把最右下角那一格讀出來 @layout pop:table:orange\n    std::cout << corner << \"\\n\";  //@ @guide {corner} @tts [next] 印出 {corner}\n    return 0;  //@ @tts [continue] 程式結束\n}", "warnings": [], "repaired": true, "prose_guides_dropped": 0, "comments_restored": 0}