  "source_code": "#include <iostream>\nusing namespace std;\nint coin[] = {1,5,10,50};\nint number[] = {0,0,0,0};\nvoid recursive(int i,int n) {\n    if (i == 4) {\n        if (n == 0) {\n            printf(\"找到coin = [%d,%d,%d,%d]\\n\",number[0],number[1],number[2],number[3]);\n        }\n        return;\n    }\n    for (number[i] = 0; number[i] <= n/coin[i]; number[i]++) {\n        recursive(i+1,n-coin[i]*number[i]);\n    }\n}\nint main() {\n    int n; cin >> n;\n    recursive(0,n);\n}",
