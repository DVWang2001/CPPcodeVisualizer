  "source_code": "#include <iostream>\n#include <vector>\nusing namespace std;\nint main() {\n    int rows = 2, cols = 3;\n    vector<vector<int>> matrix = {{1, 2, 3}, {4, 5, 6}};\n    vector<vector<int>> transposed(cols, vector<int>(rows));\n \n    for (int i = 0; i < rows; i++) {\n        for (int j = 0; j < cols; j++) {\n            transposed[j][i] = matrix[i][j];\n        }\n    }\n \n    return 0;\n}",
